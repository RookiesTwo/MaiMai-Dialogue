{
  "presentation": {
    "theme": "maimai_dialogue:default",
    "background": {
      "variants": {
        "default": "minecraft:gui/title/background/panorama_0.png",
        "alternate": "minecraft:gui/title/background/panorama_1.png"
      },
      "initial_variant": "default",
      "fit": "cover",
      "opacity": 0.82
    },
    "dialogue_box": {
      "x": 0.5,
      "y": 0.98,
      "width": 0.96,
      "max_height": 0.5,
      "anchor": "bottom_center"
    },
    "visual_objects": {
      "demo_marker": {
        "variants": {
          "default": "minecraft:item/emerald.png",
          "alternate": "minecraft:item/diamond.png"
        },
        "initial_variant": "default",
        "x": 0.5,
        "y": 0.3,
        "anchor": "center",
        "scale": 8.0,
        "opacity": 0.9,
        "visible": true,
        "z_index": 10
      }
    },
    "filter": {
      "type": "color_adjust",
      "brightness": -0.03,
      "contrast": 1.08,
      "saturation": 0.55,
      "tint": "#30A0C8FF"
    }
  },
  "steps": [
    {
      "speaker": {
        "type": "set",
        "id": "maimai_dialogue:demo/guide"
      },
      "text": "MaiMai Dialogue demo",
      "actions": [
        {
          "target": "demo_marker",
          "action": {
            "type": "reference",
            "id": "maimai_dialogue:demo/marker_enter"
          }
        }
      ]
    }
  ],
  "end": {
    "text": "Choose a dialogue.",
    "actions": [
      {
        "target": "demo_marker",
        "action": {
          "type": "inline",
          "action": {
            "duration_ms": 500,
            "easing": "ease_in_out",
            "x": [
              {
                "at": 1.0,
                "value": 0.18
              }
            ],
            "variant": {
              "at": 0.55,
              "value": "alternate"
            }
          }
        }
      },
      {
        "target": "background",
        "action": {
          "type": "inline",
          "action": {
            "duration_ms": 500,
            "easing": "ease_in_out",
            "variant": {
              "at": 0.55,
              "value": "alternate"
            }
          }
        }
      }
    ],
    "exit": {
      "type": "options",
      "options": [
        {
          "text": "Open the public dialogue",
          "icon": "dialogue",
          "target": {
            "type": "dialogue",
            "dialogue": "maimai_dialogue:demo/public"
          }
        },
        {
          "text": "Open the progress-gated dialogue",
          "icon": "question",
          "target": {
            "type": "dialogue",
            "dialogue": "maimai_dialogue:demo/locked"
          }
        },
        {
          "text": "Open the parchment theme demo",
          "icon": "dialogue",
          "target": {
            "type": "dialogue",
            "dialogue": "maimai_dialogue:demo/theme"
          }
        },
        {
          "text": "Open the CRT and Bloom demo",
          "icon": "dialogue",
          "target": {
            "type": "dialogue",
            "dialogue": "maimai_dialogue:demo/crt"
          }
        },
        {
          "text": "Close",
          "target": {
            "type": "return"
          }
        }
      ]
    }
  }
}
